<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.TitlebarUtility"><Setter Property="Background" Value="#12171E" /></Style>
  <Style Selector="Border.BrandDock"><Setter Property="Background" Value="{DynamicResource ChromeBar}" /><Setter Property="Padding" Value="7,4,13,4" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="Border.NavigationDock"><Setter Property="Background" Value="#12171E" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="4,2" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="Button.UtilityLink"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="8,3" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.UtilityLink:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.BrowserArrow"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="32" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="21" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.BrowserArrow:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.WindowControl"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="28" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="15" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.WindowControl:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.WindowControl.Close:pointerover"><Setter Property="Background" Value="#C23B4A" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.MenuLink"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="6,3" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="Button.MenuLink:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.HeaderAction"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="8,5" /><Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="Button.HeaderAction:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="TextBlock.HeaderAccountName"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,4,0" /></Style>
  <Style Selector="Button.HeaderSettings"><Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="15" /><Setter Property="FontSize" Value="16" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.HeaderSettings:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.NavButton"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="12,11" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="14" /><Setter Property="Margin" Value="0,0,0,2" /></Style>
  <Style Selector="Button.NavButton:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.NavButton.Active"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.NavButton.HomeButton"><Setter Property="Height" Value="34" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="10,7" /><Setter Property="Margin" Value="0" /><Setter Property="CornerRadius" Value="4" /></Style>
  <Style Selector="Button.CollectionButton"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.CollectionButton:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.CollectionCreateCard"><Setter Property="Width" Value="200" /><Setter Property="Height" Value="200" /><Setter Property="Margin" Value="0,0,18,18" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.CollectionCreateCard:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}" /></Style>
  <Style Selector="Button.CollectionCard"><Setter Property="Width" Value="200" /><Setter Property="Height" Value="200" /><Setter Property="Margin" Value="0,0,18,18" /><Setter Property="Background" Value="{DynamicResource SurfacePrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="Button.CollectionCard:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}" /><Setter Property="Opacity" Value="0.92" /></Style>
  <Style Selector="TextBlock.CollectionCreateGlyph"><Setter Property="FontSize" Value="34" /><Setter Property="FontWeight" Value="Light" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="TextBlock.CollectionCardTitle"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="LetterSpacing" Value="1.1" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="TextBlock.CollectionCardCount"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.2" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.GamesHeader"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="10,7" /><Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="Button.GamesHeader:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="CheckBox.LibraryMenuItem"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="4,3" /><Setter Property="MinHeight" Value="25" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style Selector="CheckBox.LibraryMenuItem:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.SidebarIconButton"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.SidebarIconButton:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.SearchClear"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="30" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.SearchClear:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.TopLink"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="10,7" /><Setter Property="CornerRadius" Value="6" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.TopLink:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.TopLink.Active"><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="Button.SidebarGame"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="5,4" /><Setter Property="Margin" Value="0,0,0,1" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="Button.SidebarGame:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.CategoryToggle"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="3" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.CategoryToggle:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="TextBlock.CategoryGlyph"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Bold" /></Style>
  <Style Selector="Button.CategoryRemove"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="13" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.CategoryRemove:pointerover"><Setter Property="Background" Value="#C23B4A" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.CategoryAction"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="7,4" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="11" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.CategoryAction:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="TextBox.CategoryInput"><Setter Property="Padding" Value="7,5" /><Setter Property="FontSize" Value="11" /><Setter Property="CornerRadius" Value="3" /></Style>
  <Style Selector="Button.DialogCancel"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="Padding" Value="12,8" /><Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="Button.DialogCancel:pointerover"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></Style>
  <Style Selector="Button.DialogConfirm"><Setter Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="#081018" /><Setter Property="Padding" Value="12,8" /><Setter Property="CornerRadius" Value="4" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.DialogConfirm:pointerover"><Setter Property="Background" Value="#48B5FF" /></Style>
  <Style Selector="Button.AddGame"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="10,6" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="Button.AddGame:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.IconButton"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="8" /><Setter Property="CornerRadius" Value="7" /></Style>
  <Style Selector="Button.DownloadStrip"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="16,7" /></Style>
  <Style Selector="Button.DownloadStrip:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.DownloadCenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="Padding" Value="12,5" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="Button.DownloadCenter:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button.Primary"><Setter Property="Background" Value="{DynamicResource AccentPrimary}" /><Setter Property="Foreground" Value="#081018" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="17,11" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.Secondary, Button.SmallSecondary"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="17,11" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="Button.SmallSecondary"><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="ProgressBar.SlimProgress"><Setter Property="Height" Value="5" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Style>
  <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="11,9" /></Style>
</Styles>
