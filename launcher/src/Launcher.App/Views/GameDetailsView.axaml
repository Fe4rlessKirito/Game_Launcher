<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.GameDetailsView">
  <StackPanel Spacing="22">
    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="16" Padding="28" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><Grid ColumnDefinitions="180,*" ColumnSpacing="26"><Border Width="180" Height="180" CornerRadius="14" Background="Transparent" ClipToBounds="True"><Grid><Image Source="{Binding ArtworkSource}" IsVisible="{Binding HasArtwork}" Stretch="Uniform" /><Image Source="{Binding ArtworkImage}" IsVisible="{Binding HasArtworkImage}" Stretch="Uniform" /><TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}" Classes="HeroStat" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Width="30" Height="30" Background="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" IsVisible="{Binding ShowSteamBadge}"><Border.OpacityMask><ImageBrush Source="avares://Launcher.App/Assets/steam-logo.png" Stretch="Uniform" /></Border.OpacityMask></Border></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><TextBlock Text="{Binding Title}" Classes="Display" /><TextBlock Text="{Binding Status}" Classes="Eyebrow" Foreground="{DynamicResource AccentPrimary}" /><TextBlock Text="{Binding Description}" Classes="Body" TextWrapping="Wrap" MaxWidth="700" /><TextBlock Text="{Binding ActionMessage}" Classes="Caption" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"><Button Content="{Binding PlayButtonLabel}" Classes="Primary" IsVisible="{Binding ShowPlay}" Command="{Binding PlayCommand}" /><Button Content="Install in Steam" Classes="Primary" IsVisible="{Binding ShowSteamInstall}" Command="{Binding InstallSteamCommand}" /><Button Content="Install / Update" Classes="Primary" IsVisible="{Binding ShowInstall}" Command="{Binding InstallCommand}" /><Button Content="Repair" Classes="Secondary" IsVisible="{Binding ShowRepair}" Command="{Binding RepairCommand}" /><Button Content="Uninstall" Classes="Secondary" IsVisible="{Binding ShowUninstall}" Command="{Binding UninstallCommand}" /></StackPanel></StackPanel></Grid></Border>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="18"><Border Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="22" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Build information" Classes="HeadingMedium" /><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10"><TextBlock Text="Version" Classes="Caption" /><TextBlock Grid.Column="1" Text="{Binding Version}" Classes="BodyStrong" /><TextBlock Grid.Row="1" Text="Install size" Classes="Caption" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallSize}" Classes="BodyStrong" /><TextBlock Grid.Row="2" Text="Integrity" Classes="Caption" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IntegrityStatus}" Classes="BodyStrong" Foreground="{DynamicResource AccentPrimary}" /></Grid></StackPanel></Border><Border Grid.Column="1" Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="22" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Installation" Classes="HeadingMedium" /><TextBlock Text="Location" Classes="Caption" /><TextBlock Text="{Binding InstallLocation}" Classes="Body" TextWrapping="Wrap" /><TextBlock Text="{Binding ExternalPlatformMessage}" IsVisible="{Binding IsExternalStoreGame}" Classes="Caption" TextWrapping="Wrap" Margin="0,10,0,0" /><TextBlock Text="Updates reuse unchanged local chunks and write new files beside the current build before commit." IsVisible="{Binding IsVaultnodeGame}" Classes="Caption" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border></Grid>
  </StackPanel>
</UserControl>
