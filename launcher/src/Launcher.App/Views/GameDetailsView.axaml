<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.GameDetailsView">
  <StackPanel Spacing="22">
    <Border Background="{DynamicResource SurfaceElevated}" CornerRadius="16" Padding="28" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><Grid ColumnDefinitions="180,*" ColumnSpacing="26"><Border Width="180" Height="180" CornerRadius="14" Background="{DynamicResource AccentSoft}"><TextBlock Text="{Binding Monogram}" Classes="HeroStat" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10"><TextBlock Text="{Binding Status}" Classes="Eyebrow" Foreground="{DynamicResource AccentPrimary}" /><TextBlock Text="{Binding Description}" Classes="Body" TextWrapping="Wrap" MaxWidth="600" /><TextBlock Text="{Binding ActionMessage}" Classes="Caption" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"><Button Content="Play" Classes="Primary" IsVisible="{Binding ShowPlay}" Command="{Binding PlayCommand}" /><Button Content="Install / Update" Classes="Primary" IsVisible="{Binding ShowInstall}" Command="{Binding InstallCommand}" /><Button Content="Repair" Classes="Secondary" IsEnabled="{Binding IsInstalled}" Command="{Binding RepairCommand}" /><Button Content="Uninstall" Classes="Secondary" IsVisible="{Binding ShowPlay}" Command="{Binding UninstallCommand}" /></StackPanel></StackPanel></Grid></Border>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="18"><Border Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="22" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Build information" Classes="HeadingMedium" /><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10"><TextBlock Text="Version" Classes="Caption" /><TextBlock Grid.Column="1" Text="{Binding Version}" Classes="BodyStrong" /><TextBlock Grid.Row="1" Text="Install size" Classes="Caption" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallSize}" Classes="BodyStrong" /><TextBlock Grid.Row="2" Text="Integrity" Classes="Caption" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Verified" Classes="BodyStrong" Foreground="{DynamicResource AccentPrimary}" /></Grid></StackPanel></Border><Border Grid.Column="1" Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="22" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Installation" Classes="HeadingMedium" /><TextBlock Text="Location" Classes="Caption" /><TextBlock Text="{Binding InstallLocation}" Classes="Body" TextWrapping="Wrap" /><TextBlock Text="Updates reuse unchanged local chunks and write new files beside the current build before commit." Classes="Caption" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border></Grid>
  </StackPanel>
</UserControl>
