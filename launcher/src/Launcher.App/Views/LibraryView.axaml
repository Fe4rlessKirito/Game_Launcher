<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.LibraryView">
  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Two builds in your local catalog." Classes="Body" /><TextBlock Text="Install roots are managed transactionally." Classes="Caption" /></StackPanel><TextBlock Grid.Column="1" Text="2 ITEMS" Classes="Eyebrow" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" /></Grid>
    <ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="310" ItemHeight="230" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,18,18" Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="18" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><Grid RowDefinitions="Auto,*,Auto"><Border Width="54" Height="54" CornerRadius="12" Background="{DynamicResource AccentSoft}"><TextBlock Text="{Binding Monogram}" Classes="Monogram" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="5"><TextBlock Text="{Binding Title}" Classes="HeadingMedium" /><TextBlock Text="{Binding Status}" Classes="Caption" Foreground="{DynamicResource TextSecondary}" /></StackPanel><Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0"><TextBlock Text="v{Binding Version}" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" /><Button Grid.Column="1" Content="Open" Command="{Binding $parent[Window].DataContext.OpenDetailsCommand}" CommandParameter="{Binding Title}" Classes="SmallSecondary" /></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
</UserControl>
