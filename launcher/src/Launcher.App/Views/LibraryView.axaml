<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.LibraryView">
  <StackPanel Spacing="24">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Recently played" Classes="SectionHeading" />
        <TextBlock Text="Jump back into a verified build or choose something new." Classes="Caption" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="YOUR LIBRARY" Classes="Eyebrow" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
    </Grid>

    <ItemsControl ItemsSource="{Binding RecentlyPlayed}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="218" ItemHeight="160" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Height="158" Margin="0,0,16,8" Background="{DynamicResource SurfacePrimary}" CornerRadius="10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
            <Grid RowDefinitions="102,Auto">
              <Border Height="102" Background="Transparent" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding ArtworkSource}" IsVisible="{Binding HasArtwork}" Stretch="Uniform" />
                  <Image Source="{Binding ArtworkImage}" IsVisible="{Binding HasArtworkImage}" Stretch="Uniform" />
                  <Ellipse Width="160" Height="160" Fill="{DynamicResource ArtworkPrimary}" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="55,-55,-55,0" IsVisible="{Binding ShowMonogram}" />
                  <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}" Classes="GameMonogram" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Width="26" Height="26" Background="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" IsVisible="{Binding ShowSteamBadge}">
                    <Border.OpacityMask>
                      <ImageBrush Source="avares://Launcher.App/Assets/steam-logo.png" Stretch="Uniform" />
                    </Border.OpacityMask>
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1" Margin="12,9,12,10" Spacing="2">
                <TextBlock Text="{Binding Title}" Classes="BodyStrong" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="Caption" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="All games" Classes="SectionHeading" />
        <TextBlock Text="Every build in your local catalog." Classes="Caption" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding GameCountDisplay}" Classes="Eyebrow" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Games}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="310" ItemHeight="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,18,10" Background="{DynamicResource SurfacePrimary}" CornerRadius="12" Padding="18" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Width="54" Height="54" CornerRadius="12" Background="Transparent" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding ArtworkSource}" IsVisible="{Binding HasArtwork}" Stretch="Uniform" />
                  <Image Source="{Binding ArtworkImage}" IsVisible="{Binding HasArtworkImage}" Stretch="Uniform" />
                  <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}" Classes="Monogram" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Width="22" Height="22" Background="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" IsVisible="{Binding ShowSteamBadge}">
                    <Border.OpacityMask>
                      <ImageBrush Source="avares://Launcher.App/Assets/steam-logo.png" Stretch="Uniform" />
                    </Border.OpacityMask>
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="4">
                <TextBlock Text="{Binding Title}" Classes="HeadingMedium" />
                <TextBlock Text="{Binding Status}" Classes="Caption" Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="v" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" />
                  <TextBlock Text="{Binding Version}" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open" Command="{Binding $parent[Window].DataContext.OpenDetailsCommand}" CommandParameter="{Binding OpenKey}" Classes="SmallSecondary" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Play next" Classes="SectionHeading" />
      <TextBlock Grid.Column="1" Text="SUGGESTED FROM YOUR LIBRARY" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
    </Grid>
    <ItemsControl ItemsSource="{Binding PlayNext}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="320" ItemHeight="94" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,16,8" Background="{DynamicResource SurfaceElevated}" CornerRadius="10" Padding="12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
            <Grid ColumnDefinitions="68,*,Auto">
              <Border Width="68" Height="68" CornerRadius="8" Background="Transparent">
                <Grid>
                  <Image Source="{Binding ArtworkSource}" IsVisible="{Binding HasArtwork}" Stretch="Uniform" />
                  <Image Source="{Binding ArtworkImage}" IsVisible="{Binding HasArtworkImage}" Stretch="Uniform" />
                  <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}" Classes="GameMonogram" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Width="22" Height="22" Background="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" IsVisible="{Binding ShowSteamBadge}">
                    <Border.OpacityMask>
                      <ImageBrush Source="avares://Launcher.App/Assets/steam-logo.png" Stretch="Uniform" />
                    </Border.OpacityMask>
                  </Border>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="13,0,8,0" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Title}" Classes="BodyStrong" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Content="{Binding Action}" Classes="SmallSecondary" VerticalAlignment="Center" Command="{Binding $parent[Window].DataContext.OpenDetailsCommand}" CommandParameter="{Binding OpenKey}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
