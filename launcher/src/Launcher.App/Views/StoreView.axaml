<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.App.Views.StoreView">
  <StackPanel Spacing="24">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <StackPanel Spacing="7" VerticalAlignment="Top">
        <TextBlock Text="VERIFIED CATALOG" Classes="Eyebrow" Foreground="{DynamicResource AccentPrimary}" />
        <TextBlock Text="Find your next game" Classes="Display" />
        <TextBlock Text="Browse authorized builds and open a game for its complete install, update, and verification details."
                   Classes="Body"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Left"
                   TextAlignment="Left"
                   MinHeight="24"
                   LineHeight="24"
                   Margin="0,0,0,2" />
      </StackPanel>
      <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center" Classes="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Search the store" />
    </Grid>

    <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="18">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoft}">
          <TextBlock Text="V" Classes="ProfileInitials" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="Authorized builds" Classes="BodyStrong" />
          <TextBlock Text="Every listing is tied to a signed manifest and BLAKE3-verified content." Classes="Caption" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding GameCountDisplay}" Classes="Eyebrow" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TextBlock Text="All games" Classes="SectionHeading" />
    <ItemsControl ItemsSource="{Binding Games}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Classes="StoreCard"
                  Command="{Binding $parent[Window].DataContext.OpenDetailsCommand}"
                  CommandParameter="{Binding Id}"
                  ToolTip.Tip="Open game details">
            <Grid RowDefinitions="150,*">
              <Border Background="Transparent" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding ArtworkSource}" IsVisible="{Binding HasArtwork}" Stretch="Uniform" />
                  <Image Source="{Binding ArtworkImage}" IsVisible="{Binding HasArtworkImage}" Stretch="Uniform" />
                  <Ellipse Width="190" Height="190" Fill="{DynamicResource ArtworkPrimary}" Opacity="0.75" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="54,-54,-54,0" IsVisible="{Binding ShowMonogram}" />
                  <Ellipse Width="86" Height="86" Fill="{DynamicResource ArtworkTertiary}" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-22,0,0,-22" IsVisible="{Binding ShowMonogram}" />
                  <TextBlock Text="{Binding Monogram}" IsVisible="{Binding ShowMonogram}" Classes="GameMonogram" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="15,12,15,14">
                <TextBlock Text="{Binding Title}" Classes="HeadingSmall" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="Caption" TextWrapping="Wrap" MaxHeight="38" Margin="0,5,0,0" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                  <TextBlock Text="{Binding Status}" Classes="Caption" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="VIEW DETAILS  ›" Classes="Eyebrow" Foreground="{DynamicResource AccentPrimary}" VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="No authorized games match this search." IsVisible="{Binding IsEmpty}" Classes="Caption" Margin="2,0,0,0" />
  </StackPanel>
</UserControl>
