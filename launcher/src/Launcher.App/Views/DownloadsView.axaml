<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.DownloadsView">
  <Grid RowDefinitions="Auto,*" MinHeight="700">
    <Border Grid.Row="0" Background="{DynamicResource DownloadChart}" Height="176" Padding="28,22" BorderThickness="0" ClipToBounds="True">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
        <StackPanel Spacing="4">
          <TextBlock Text="DOWNLOAD ACTIVITY" Classes="Eyebrow" Foreground="{DynamicResource AccentPrimary}" />
          <TextBlock Text="Network overview" Classes="HeadingMedium" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="36" VerticalAlignment="Bottom">
          <StackPanel Spacing="3"><TextBlock Text="NETWORK" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="{Binding NetworkRate}" Classes="HeadingMedium" Foreground="{DynamicResource TextPrimary}" /></StackPanel>
          <StackPanel Spacing="3"><TextBlock Text="PEAK" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="{Binding PeakRate}" Classes="HeadingMedium" Foreground="{DynamicResource AccentPrimary}" /></StackPanel>
          <StackPanel Spacing="3"><TextBlock Text="PREPARED" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="{Binding PreparedRate}" Classes="HeadingMedium" Foreground="{DynamicResource TextPrimary}" /></StackPanel>
          <StackPanel Spacing="3"><TextBlock Text="DISK WRITE" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="{Binding DiskRate}" Classes="HeadingMedium" Foreground="{DynamicResource TextPrimary}" /></StackPanel>
        </StackPanel>
        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RateHistory}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="58">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate><Border Width="4" Height="{Binding}" Background="{DynamicResource AccentPrimary}" VerticalAlignment="Bottom" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Spacing="0">
      <Grid ColumnDefinitions="*,Auto" Margin="28,18,28,0">
        <TextBlock Text="{Binding LastActionMessage}" Classes="Caption" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Content="Pause" Classes="SmallSecondary" Command="{Binding PauseActiveDownloadCommand}" IsVisible="{Binding CanPauseActiveDownload}" />
          <Button Content="Resume" Classes="SmallSecondary" Command="{Binding ResumeActiveDownloadCommand}" IsVisible="{Binding CanResumeActiveDownload}" />
        </StackPanel>
      </Grid>

      <StackPanel Margin="28,30,28,0" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Current" Classes="SectionHeading" /><TextBlock Text="{Binding ActiveCount}" Classes="Caption" VerticalAlignment="Center" /></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding ActiveSummary}" Classes="Caption" />
        </Grid>
        <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        <ItemsControl ItemsSource="{Binding Active}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,*,Auto" Margin="0,8,0,0" MinHeight="70">
                <Border Width="48" Height="48" CornerRadius="2" Background="{DynamicResource AccentPrimary}"><TextBlock Text="{Binding Monogram}" Classes="GameMonogram" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding Title}" Classes="BodyStrong" />
                  <TextBlock Text="{Binding Detail}" Classes="Caption" />
                  <ProgressBar IsVisible="{Binding HasProgress}" Value="{Binding ProgressPercentage}" Maximum="100" Height="4" HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Classes="Caption" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Margin="28,34,28,0" Spacing="12" IsVisible="{Binding HasUpNext}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Up next" Classes="SectionHeading" /><TextBlock Text="{Binding UpNextCount}" Classes="Caption" VerticalAlignment="Center" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpNextSummary}" Classes="Caption" /></Grid>
        <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        <ItemsControl ItemsSource="{Binding UpNext}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,*,Auto,Auto" Margin="0,8,0,0" MinHeight="62">
                <Border Width="48" Height="48" CornerRadius="2" Background="{DynamicResource ArtworkSecondary}"><TextBlock Text="{Binding Monogram}" Classes="GameMonogram" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Title}" Classes="BodyStrong" /><TextBlock Text="{Binding Detail}" Classes="Caption" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Classes="Caption" VerticalAlignment="Center" Margin="0,0,22,0" />
                <Button Grid.Column="3" Content="GET" Classes="SmallSecondary" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.InstallScheduledCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Margin="28,34,28,0" Spacing="12" IsVisible="{Binding HasScheduled}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Scheduled" Classes="SectionHeading" /><TextBlock Text="{Binding ScheduledCount}" Classes="Caption" VerticalAlignment="Center" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ScheduledSummary}" Classes="Caption" /></Grid>
        <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        <ItemsControl ItemsSource="{Binding Scheduled}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,*,Auto,Auto" Margin="0,8,0,0" MinHeight="62">
                <Border Width="48" Height="48" CornerRadius="2" Background="{DynamicResource ArtworkSecondary}"><TextBlock Text="{Binding Monogram}" Classes="GameMonogram" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Title}" Classes="BodyStrong" /><TextBlock Text="{Binding Detail}" Classes="Caption" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Classes="Caption" VerticalAlignment="Center" Margin="0,0,22,0" />
                <Button Grid.Column="3" Content="GET" Classes="SmallSecondary" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.InstallScheduledCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Margin="28,34,28,0" Spacing="12" IsVisible="{Binding HasNeedsAttention}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Needs attention" Classes="SectionHeading" /><TextBlock Text="{Binding NeedsAttentionCount}" Classes="Caption" VerticalAlignment="Center" /></StackPanel><TextBlock Grid.Column="1" Text="Retry an interrupted install" Classes="Caption" /></Grid>
        <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        <ItemsControl ItemsSource="{Binding NeedsAttention}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,*,Auto,Auto" Margin="0,8,0,0" MinHeight="62">
                <Border Width="48" Height="48" CornerRadius="2" Background="{DynamicResource ArtworkSecondary}"><TextBlock Text="{Binding Monogram}" Classes="GameMonogram" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Title}" Classes="BodyStrong" /><TextBlock Text="{Binding Detail}" Classes="Caption" TextWrapping="Wrap" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Classes="Caption" VerticalAlignment="Center" Margin="0,0,22,0" />
                <Button Grid.Column="3" Content="RETRY" Classes="SmallSecondary" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.InstallScheduledCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Margin="28,34,28,38" Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Completed" Classes="SectionHeading" /><TextBlock Text="{Binding CompletedCount}" Classes="Caption" VerticalAlignment="Center" /></StackPanel><Button Grid.Column="1" Content="Clear All" Classes="SmallSecondary" Command="{Binding ClearCompletedCommand}" /></Grid>
        <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        <ItemsControl ItemsSource="{Binding Completed}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,*,Auto,Auto" Margin="0,8,0,0" MinHeight="62">
                <Border Width="48" Height="48" CornerRadius="2" Background="{DynamicResource ArtworkPrimary}"><TextBlock Text="{Binding Monogram}" Classes="GameMonogram" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Title}" Classes="BodyStrong" /><TextBlock Text="{Binding Detail}" Classes="Caption" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Classes="Caption" VerticalAlignment="Center" Margin="0,0,22,0" />
                <Button Grid.Column="3" Content="PLAY" Classes="Primary" VerticalAlignment="Center" Command="{Binding $parent[Window].DataContext.OpenDetailsCommand}" CommandParameter="{Binding Title}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
