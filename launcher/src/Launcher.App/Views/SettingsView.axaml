<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.SettingsView">
  <Grid MaxWidth="1040" ColumnDefinitions="184,*" ColumnSpacing="24" VerticalAlignment="Top" Margin="0,0,0,48">
    <Border Grid.Column="0"
            Background="{DynamicResource SurfacePrimary}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10">
      <StackPanel Spacing="3">
        <TextBlock Text="SETTINGS" Classes="Eyebrow" Foreground="{DynamicResource TextMuted}" Margin="8,5,8,8" />
        <Button Content="Profile" Classes="SettingsNavItem" Classes.active="{Binding IsProfileSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Profile" />
        <Button Content="General" Classes="SettingsNavItem" Classes.active="{Binding IsGeneralSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="General" />
        <Button Content="Downloads" Classes="SettingsNavItem" Classes.active="{Binding IsDownloadsSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Downloads" />
        <Button Content="Steam" Classes="SettingsNavItem" Classes.active="{Binding IsSteamSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Steam" />
        <Button Content="Epic Games" Classes="SettingsNavItem" Classes.active="{Binding IsEpicSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Epic" />
        <Button Content="Other stores" Classes="SettingsNavItem" Classes.active="{Binding IsIntegrationsSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Integrations" />
        <Button Content="Appearance" Classes="SettingsNavItem" Classes.active="{Binding IsAppearanceSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Appearance" />
        <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="8,8" />
        <Button Content="Advanced" Classes="SettingsNavItem" Classes.active="{Binding IsAdvancedSelected}" Command="{Binding SelectSectionCommand}" CommandParameter="Advanced" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" Spacing="18" MinWidth="0">
      <StackPanel IsVisible="{Binding IsProfileSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Profile" Classes="HeadingLarge" />
          <TextBlock Text="Choose the picture shown in the launcher header." Classes="Caption" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="16">
            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSoft}" ClipToBounds="True" VerticalAlignment="Center">
              <Grid>
                <Image Source="{Binding ProfileImage}" IsVisible="{Binding HasProfileImage}" Stretch="UniformToFill" />
                <TextBlock Text="V" IsVisible="{Binding ShowDefaultProfile}" Classes="ProfileInitials" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
              <TextBox Text="{Binding ProfileImagePath, Mode=TwoWay}" PlaceholderText="Image path" />
              <TextBlock Text="PNG, JPG, or another image Avalonia can load." Classes="Caption" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Choose" Classes="SmallSecondary" Click="OnChooseProfileImageClick" />
              <Button Content="Default" Classes="SmallSecondary" Command="{Binding ClearProfileImageCommand}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="Vaultnode account" Classes="HeadingMedium" />
              <TextBlock Text="Sign in to connect this launcher to your library." Classes="Caption" />
            </StackPanel>
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
              <TextBlock Text="Email address" Classes="Caption" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding AccountEmail, Mode=TwoWay}" IsEnabled="{Binding IsNotSignedIn}" PlaceholderText="Email address" />
              <TextBlock Grid.Row="1" Text="Password" Classes="Caption" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AccountPassword, Mode=TwoWay}" PasswordChar="●" IsEnabled="{Binding IsNotSignedIn}" PlaceholderText="Password" />
              <TextBlock Grid.Row="2" Text="Username" Classes="Caption" VerticalAlignment="Center" IsVisible="{Binding IsSignedIn}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSignedIn}">
                <TextBox Width="220" Text="{Binding AccountUsername, Mode=TwoWay}" PlaceholderText="Username" />
                <Button Content="Save" Classes="SmallSecondary" Command="{Binding SaveUsernameCommand}" IsEnabled="{Binding CanSubmitAuth}" />
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Sign in" Classes="Primary" Command="{Binding SignInCommand}" IsVisible="{Binding IsNotSignedIn}" IsEnabled="{Binding CanSubmitAuth}" />
                <Button Content="Sign out" Classes="SmallSecondary" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" IsEnabled="{Binding CanSubmitAuth}" />
                <TextBlock Text="{Binding AuthStatus}" Classes="Caption" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsGeneralSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="General" Classes="HeadingLarge" />
          <TextBlock Text="Control how Vaultnode starts and behaves on your desktop." Classes="Caption" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Launch on startup" Classes="BodyStrong" />
                <TextBlock Text="Open Vaultnode when Windows starts." Classes="Caption" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnStartup}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Minimize on close" Classes="BodyStrong" />
                <TextBlock Text="Keep background downloads available when the window is closed." Classes="Caption" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeOnClose}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="4">
                <TextBlock Text="Automatic launcher updates" Classes="BodyStrong" />
                <TextBlock Text="Check GitHub Releases automatically and show a review banner when a new installer is available. Installation always needs your confirmation." Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutomaticUpdatesEnabled}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsDownloadsSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Downloads" Classes="HeadingLarge" />
          <TextBlock Text="Choose where games are staged and installed." Classes="Caption" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
            <TextBlock Text="Download cache directory" Classes="Caption" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DownloadDirectory}" />
            <TextBlock Grid.Row="1" Text="Game directory" Classes="Caption" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InstallDirectory}" />
            <TextBlock Grid.Row="2" Text="Concurrent downloads" Classes="Caption" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ConcurrentDownloads}" Minimum="1" Maximum="32" />
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsSteamSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Steam" Classes="HeadingLarge" />
          <TextBlock Text="Use local detection without connecting, or link Steam to import the complete visible library and start installs through Steam." Classes="Caption" TextWrapping="Wrap" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SteamStatus}" Classes="HeadingMedium" />
                <TextBlock Text="{Binding SteamLibrarySummary}" Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Refresh installed games" Classes="SmallSecondary" Command="{Binding RefreshSteamCommand}" IsEnabled="{Binding CanConnectSteam}" VerticalAlignment="Center" />
            </Grid>
            <Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="16">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Connect Steam account" Classes="BodyStrong" />
                  <TextBlock Text="Steam opens its own sign-in page. Vaultnode never receives your Steam password." Classes="Caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SteamConnectionStatus}" Classes="Caption" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="{Binding SteamConnectButtonLabel}" Classes="Primary" Command="{Binding ConnectSteamCommand}" IsEnabled="{Binding CanConnectSteam}" />
                  <Button Content="Disconnect" Classes="SmallSecondary" Command="{Binding DisconnectSteamCommand}" IsVisible="{Binding HasSteamAccount}" IsEnabled="{Binding CanConnectSteam}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Owned games are added to the library as Available in Steam. Clicking install hands the request to the Steam client; Vaultnode never copies Steam game files." Classes="Caption" TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Border IsVisible="{Binding HasSteamGames}" Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="Installed games" Classes="BodyStrong" />
                <ItemsControl ItemsSource="{Binding SteamGames}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                        <TextBlock Text="{Binding Name}" Classes="BodyStrong" />
                        <TextBlock Grid.Row="1" Text="{Binding InstallRoot}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Classes="Caption" VerticalAlignment="Center" Margin="16,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasSteamOwnedGames}" Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Owned library synced" Classes="BodyStrong" />
                  <TextBlock Text="These games are available in the launcher and can be installed through Steam." Classes="Caption" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SteamOwnedGames.Count}" Classes="HeadingMedium" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Text="Local detection, favorites, launching, and Steam-client install handoff work without connecting. Full owned-library sync depends on the server Steam Web API key and your Steam game-details visibility." Classes="Caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsEpicSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Epic Games" Classes="HeadingLarge" />
          <TextBlock Text="Detect installed Epic titles locally and hand launching back to Epic Games Launcher." Classes="Caption" TextWrapping="Wrap" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding EpicStatus}" Classes="HeadingMedium" />
                <TextBlock Text="{Binding EpicLibrarySummary}" Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Refresh installed games" Classes="SmallSecondary" Command="{Binding RefreshEpicCommand}" />
                <Button Content="Open Epic Launcher" Classes="Primary" Command="{Binding OpenEpicLauncherCommand}" />
              </StackPanel>
            </Grid>
            <Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="16">
              <StackPanel Spacing="5">
                <TextBlock Text="Epic account library" Classes="BodyStrong" />
                <TextBlock Text="{Binding EpicAccountStatus}" Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasEpicGames}" Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="Installed games" Classes="BodyStrong" />
                <ItemsControl ItemsSource="{Binding EpicGames}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                        <TextBlock Text="{Binding Name}" Classes="BodyStrong" />
                        <TextBlock Grid.Row="1" Text="{Binding InstallRoot}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Classes="Caption" VerticalAlignment="Center" Margin="16,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="Vaultnode does not copy, update, verify, or uninstall Epic files. Epic Games Launcher remains responsible for account ownership, downloads, updates, and file management." Classes="Caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsIntegrationsSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Other stores" Classes="HeadingLarge" />
          <TextBlock Text="Optional local integrations for games installed outside Vaultnode. Steam and Epic are enabled by default; these integrations are off until you turn them on." Classes="Caption" TextWrapping="Wrap" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <StackPanel Spacing="14">
            <TextBlock Text="Local detection only" Classes="BodyStrong" />
            <TextBlock Text="When enabled, Vaultnode scans the provider's known local install folders and launches detected executables. It does not connect accounts, collect passwords, or replace the provider's downloads, updates, ownership, or file management." Classes="Caption" TextWrapping="Wrap" />
            <Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="8" Padding="16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="GOG Galaxy" Classes="BodyStrong" />
                    <TextBlock Text="{Binding GogIntegrationStatus}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding GogIntegrationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Ubisoft Connect" Classes="BodyStrong" />
                    <TextBlock Text="{Binding UbisoftIntegrationStatus}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding UbisoftIntegrationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="EA app" Classes="BodyStrong" />
                    <TextBlock Text="{Binding EaIntegrationStatus}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding EaIntegrationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Battle.net" Classes="BodyStrong" />
                    <TextBlock Text="{Binding BattleNetIntegrationStatus}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding BattleNetIntegrationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Xbox / Microsoft Store" Classes="BodyStrong" />
                    <TextBlock Text="{Binding XboxIntegrationStatus}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding XboxIntegrationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="itch.io" Classes="BodyStrong" />
                    <TextBlock Text="{Binding ItchIntegrationStatus}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ItchIntegrationEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Refresh enabled stores" Classes="SmallSecondary" Command="{Binding RefreshOptionalStoresCommand}" />
              <TextBlock Text="Save changes to keep the toggles after restart." Classes="Caption" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsAppearanceSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Appearance" Classes="HeadingLarge" />
          <TextBlock Text="Adjust how the launcher feels while you use it." Classes="Caption" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <Grid ColumnDefinitions="210,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
            <TextBlock Text="Theme" Classes="BodyStrong" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemePreset}" />

            <StackPanel Grid.Row="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Accent color" Classes="BodyStrong" />
              <TextBlock Text="{Binding AccentColorDescription}" Classes="Caption" TextWrapping="Wrap" MaxWidth="198" />
            </StackPanel>
            <ColorPicker Grid.Row="1"
                         Grid.Column="1"
                         Width="190"
                         HorizontalAlignment="Left"
                         Color="{Binding AccentColorValue, Mode=TwoWay}"
                         IsAlphaEnabled="False"
                         IsHexInputVisible="False" />

            <StackPanel Grid.Row="2" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Compact layout" Classes="BodyStrong" />
              <TextBlock Text="Reduce sidebar spacing and width." Classes="Caption" />
            </StackPanel>
            <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding CompactMode}" HorizontalAlignment="Left" />

            <StackPanel Grid.Row="3" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Custom background" Classes="BodyStrong" />
              <TextBlock Text="Show a local image behind the launcher chrome. Selected images are copied into Vaultnode AppData." Classes="Caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Border Width="160" Height="90" CornerRadius="7" Background="{DynamicResource SurfaceElevated}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
                <Image Source="{Binding BackgroundImage}" IsVisible="{Binding HasBackgroundImage}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Spacing="7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Choose image" Classes="SmallSecondary" Click="OnChooseBackgroundImageClick" />
                  <Button Content="Clear" Classes="SmallSecondary" Command="{Binding ClearBackgroundImageCommand}" IsVisible="{Binding HasBackgroundImage}" />
                </StackPanel>
                <TextBlock Text="{Binding BackgroundImagePath}" Classes="Caption" MaxWidth="360" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasBackgroundImage}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Interface transparency" Classes="BodyStrong" />
              <TextBlock Text="Make launcher surfaces translucent while keeping text readable." Classes="Caption" TextWrapping="Wrap" MaxWidth="198" />
            </StackPanel>
            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
              <Slider Minimum="0" Maximum="70" Value="{Binding InterfaceTransparencyPercent, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" Text="{Binding InterfaceTransparencyDisplay}" Classes="BodyStrong" MinWidth="42" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="5" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Background image visibility" Classes="BodyStrong" />
              <TextBlock Text="Control how strongly the selected image shows through the launcher." Classes="Caption" TextWrapping="Wrap" MaxWidth="198" />
            </StackPanel>
            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
              <Slider Minimum="0" Maximum="100" Value="{Binding BackgroundImageOpacityPercent, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" Text="{Binding BackgroundImageOpacityDisplay}" Classes="BodyStrong" MinWidth="42" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="6" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Match background colors" Classes="BodyStrong" />
              <TextBlock Text="Tint the launcher surfaces and accent from the selected image." Classes="Caption" TextWrapping="Wrap" MaxWidth="198" />
            </StackPanel>
            <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding MatchBackgroundColors}" HorizontalAlignment="Left" />
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsAdvancedSelected}" Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Advanced" Classes="HeadingLarge" />
          <TextBlock Text="Storage and connection options for this installation." Classes="Caption" />
        </StackPanel>
        <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="10" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="180,*">
              <StackPanel Spacing="3">
                <TextBlock Text="Verified cache size" Classes="BodyStrong" />
                <TextBlock Text="Local space reserved for verified packs." Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
              <NumericUpDown Grid.Column="1" Value="{Binding CacheSizeGigabytes}" Minimum="1" Maximum="256" />
            </Grid>
            <Grid ColumnDefinitions="180,*">
              <StackPanel Spacing="3">
                <TextBlock Text="Launcher API" Classes="BodyStrong" />
                <TextBlock Text="Only change this when using a different server." Classes="Caption" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding ApiBaseUrl}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
        <Button Content="Save changes" Classes="Primary" Command="{Binding SaveCommand}" />
        <Button Content="Reset" Classes="SmallSecondary" Command="{Binding ResetCommand}" />
        <TextBlock Text="{Binding SaveStatus}" Classes="Caption" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
