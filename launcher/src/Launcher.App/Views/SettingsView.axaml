<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Launcher.App.Views.SettingsView">
  <StackPanel Spacing="18" MaxWidth="820" VerticalAlignment="Top" Margin="0,0,0,48">
    <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
      <StackPanel Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Profile" Classes="HeadingMedium" />
          <TextBlock Text="Choose the picture shown in the launcher header." Classes="Caption" />
        </StackPanel>
        <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="16">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSoft}" ClipToBounds="True" VerticalAlignment="Center">
            <Grid>
              <Image Source="{Binding ProfileImage}" IsVisible="{Binding HasProfileImage}" Stretch="UniformToFill" />
              <TextBlock Text="V" IsVisible="{Binding ShowDefaultProfile}" Classes="ProfileInitials" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <TextBox Text="{Binding ProfileImagePath, Mode=TwoWay}" PlaceholderText="Image path" />
            <TextBlock Text="PNG, JPG, or another image Avalonia can load." Classes="Caption" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Choose" Classes="SmallSecondary" Click="OnChooseProfileImageClick" />
            <Button Content="Default" Classes="SmallSecondary" Command="{Binding ClearProfileImageCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="18"><TextBlock Text="General" Classes="HeadingMedium" /><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><StackPanel Spacing="4"><TextBlock Text="Launch on startup" Classes="BodyStrong" /><TextBlock Text="Open Launcher when Windows starts." Classes="Caption" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnStartup}" /><StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="4"><TextBlock Text="Minimize on close" Classes="BodyStrong" /><TextBlock Text="Keep background downloads available." Classes="Caption" /></StackPanel><ToggleSwitch Grid.Row="1" Grid.Column="1" Margin="0,18,0,0" IsChecked="{Binding MinimizeOnClose}" /></Grid></StackPanel></Border>
    <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="18"><TextBlock Text="Downloads &amp; installation" Classes="HeadingMedium" /><Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14"><TextBlock Text="Download directory" Classes="Caption" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding DownloadDirectory}" /><TextBlock Grid.Row="1" Text="Game directory" Classes="Caption" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InstallDirectory}" /><TextBlock Grid.Row="2" Text="Concurrent chunks" Classes="Caption" VerticalAlignment="Center" /><NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ConcurrentDownloads}" Minimum="1" Maximum="32" /><TextBlock Grid.Row="3" Text="Launcher API" Classes="Caption" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ApiBaseUrl}" /></Grid></StackPanel></Border>
    <Border Background="{DynamicResource SurfacePrimary}" CornerRadius="14" Padding="24" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"><StackPanel Spacing="18"><TextBlock Text="Appearance" Classes="HeadingMedium" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Reduced motion" Classes="BodyStrong" /><TextBlock Grid.Column="1" Text="Use shorter transitions and no decorative movement." Classes="Caption" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding ReducedMotion}" /></Grid></StackPanel></Border>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0"><Button Content="Save changes" Classes="Primary" Command="{Binding SaveCommand}" /><Button Content="Reset" Classes="SmallSecondary" Command="{Binding ResetCommand}" /><TextBlock Text="{Binding SaveStatus}" Classes="Caption" VerticalAlignment="Center" /></StackPanel>
  </StackPanel>
</UserControl>
