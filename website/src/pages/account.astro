---
import BaseLayout from '../layouts/BaseLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const launcherApiUrl = import.meta.env.PUBLIC_LAUNCHER_API_URL ?? 'https://vaultnode.pp.ua';
---

<BaseLayout title="Account — Vaultnode" description="Manage your Vaultnode account.">
  <section class="account-page" data-supabase-url={supabaseUrl} data-supabase-anon-key={supabaseAnonKey} data-launcher-api={launcherApiUrl}>
    <div class="account-heading">
      <div>
        <p class="account-kicker">ACCOUNT</p>
        <h1>Vaultnode account</h1>
        <p class="account-lead">Sign in to manage your library and connect the desktop launcher.</p>
      </div>
      <a class="account-heading-link" href="/download/">Get the launcher <span aria-hidden="true">→</span></a>
    </div>

    <div class="account-layout">
      <div class="account-overview">
        <div class="account-product">
          <img src="/assets/vaultnode-mark.png" alt="" />
          <span>Vaultnode</span>
        </div>
        <h2>Your library in one place.</h2>
        <p class="account-overview-copy">Use your account to keep your authorized library available on the website and in the Windows launcher.</p>
        <dl class="account-points">
          <div><dt>Library access</dt><dd>View the builds available to you.</dd></div>
          <div><dt>Desktop connection</dt><dd>Use the same account in the launcher.</dd></div>
          <div><dt>Secure sign-in</dt><dd>Your password is handled by Supabase Auth.</dd></div>
        </dl>
      </div>

      <div class="account-form-wrap">
        <div id="auth-config-warning" hidden class="account-notice">Account sign-in is not configured yet.</div>

        <div id="auth-forms" class="account-auth-grid">
          <form id="login-form" class="account-card" novalidate>
            <div class="account-card-heading">
              <div>
                <p class="account-card-kicker">EXISTING ACCOUNT</p>
                <h2>Sign in</h2>
              </div>
              <span class="account-card-mark" aria-hidden="true">V</span>
            </div>
            <p class="account-card-description">Use your Vaultnode email and password.</p>
            <div class="account-fields">
              <div class="account-field">
                <label for="login-email">Email address</label>
                <input id="login-email" type="email" autocomplete="email" required />
              </div>
              <div class="account-field">
                <label for="login-password">Password</label>
                <input id="login-password" type="password" autocomplete="current-password" minlength="8" required />
              </div>
            </div>
            <div class="account-actions">
              <button id="login-submit" class="account-submit" type="submit">Sign in</button>
            </div>
            <p id="login-message" class="account-message" role="status" aria-live="polite"></p>
          </form>

          <form id="register-form" class="account-card" novalidate>
            <div class="account-card-heading">
              <div>
                <p class="account-card-kicker">NEW ACCOUNT</p>
                <h2>Create account</h2>
              </div>
              <span class="account-card-mark" aria-hidden="true">+</span>
            </div>
            <p class="account-card-description">Create an account for your Vaultnode library.</p>
            <div class="account-fields">
              <div class="account-field">
                <label for="register-email">Email address</label>
                <input id="register-email" type="email" autocomplete="email" required />
              </div>
              <div class="account-field">
                <label for="register-password">Password</label>
                <input id="register-password" type="password" autocomplete="new-password" minlength="8" required />
              </div>
            </div>
            <div class="account-actions">
              <button id="register-submit" class="account-submit" type="submit">Create account</button>
            </div>
            <p id="register-message" class="account-message" role="status" aria-live="polite"></p>
          </form>
        </div>

        <div id="account-panel" hidden class="account-card signed-in-card">
          <p class="account-card-kicker">SIGNED IN</p>
          <h2>Welcome back</h2>
          <p class="signed-in-email" id="account-email"></p>
          <p id="launcher-session" class="account-card-description">Checking launcher access…</p>
          <button id="auth-signout" class="account-toggle" type="button">Sign out</button>
        </div>
        <p class="account-footnote">Use this account only for authorized Vaultnode content.</p>
      </div>
    </div>
  </section>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const root = document.querySelector<HTMLElement>('[data-supabase-url]');
    const supabaseUrl = root?.dataset.supabaseUrl ?? '';
    const supabaseAnonKey = root?.dataset.supabaseAnonKey ?? '';
    const launcherApi = (root?.dataset.launcherApi ?? 'https://vaultnode.pp.ua').replace(/\/$/, '');
    const authForms = document.querySelector<HTMLElement>('#auth-forms');
    const loginForm = document.querySelector<HTMLFormElement>('#login-form');
    const registerForm = document.querySelector<HTMLFormElement>('#register-form');
    const authPanel = document.querySelector<HTMLElement>('#account-panel');
    const configWarning = document.querySelector<HTMLElement>('#auth-config-warning');
    const loginEmail = document.querySelector<HTMLInputElement>('#login-email');
    const loginPassword = document.querySelector<HTMLInputElement>('#login-password');
    const loginSubmit = document.querySelector<HTMLButtonElement>('#login-submit');
    const loginMessage = document.querySelector<HTMLElement>('#login-message');
    const registerEmail = document.querySelector<HTMLInputElement>('#register-email');
    const registerPassword = document.querySelector<HTMLInputElement>('#register-password');
    const registerSubmit = document.querySelector<HTMLButtonElement>('#register-submit');
    const registerMessage = document.querySelector<HTMLElement>('#register-message');
    const accountEmail = document.querySelector<HTMLElement>('#account-email');
    const launcherSession = document.querySelector<HTMLElement>('#launcher-session');
    const signOut = document.querySelector<HTMLButtonElement>('#auth-signout');

    const message = (element: HTMLElement | null, value: string) => { if (element) element.textContent = value; };

    const supabase = supabaseUrl && supabaseAnonKey
      ? createClient(supabaseUrl, supabaseAnonKey, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } })
      : null;

    async function checkLauncherAccess(accessToken: string) {
      if (!launcherSession) return;
      try {
        const response = await fetch(`${launcherApi}/api/v1/me`, { headers: { Authorization: `Bearer ${accessToken}` }, cache: 'no-store' });
        launcherSession.textContent = response.ok ? 'Launcher access connected.' : response.status === 503 ? 'Launcher account linking is not enabled yet.' : 'Launcher access needs attention.';
      } catch {
        launcherSession.textContent = 'Launcher access is currently unavailable.';
      }
    }

    async function renderSession() {
      if (!supabase) {
        if (configWarning) configWarning.hidden = false;
        if (authForms) authForms.hidden = true;
        return;
      }
      const { data } = await supabase.auth.getSession();
      const session = data.session;
      if (session) {
        if (authForms) authForms.hidden = true;
        if (authPanel) authPanel.hidden = false;
        if (accountEmail) accountEmail.textContent = session.user.email ?? session.user.id;
        await checkLauncherAccess(session.access_token);
      } else {
        if (authForms) authForms.hidden = false;
        if (authPanel) authPanel.hidden = true;
      }
    }

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!supabase || !loginEmail || !loginPassword) return;
      if (!loginEmail.value || loginPassword.value.length < 8) { message(loginMessage, 'Enter a valid email and an 8-character password.'); return; }
      if (loginSubmit) loginSubmit.disabled = true;
      message(loginMessage, 'Signing in…');
      const result = await supabase.auth.signInWithPassword({ email: loginEmail.value, password: loginPassword.value });
      if (loginSubmit) loginSubmit.disabled = false;
      if (result.error) { message(loginMessage, result.error.message); return; }
      message(loginMessage, 'Signed in.');
      await renderSession();
    });
    registerForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!supabase || !registerEmail || !registerPassword) return;
      if (!registerEmail.value || registerPassword.value.length < 8) { message(registerMessage, 'Enter a valid email and an 8-character password.'); return; }
      if (registerSubmit) registerSubmit.disabled = true;
      message(registerMessage, 'Creating account…');
      const result = await supabase.auth.signUp({ email: registerEmail.value, password: registerPassword.value, options: { emailRedirectTo: `${window.location.origin}/account/` } });
      if (registerSubmit) registerSubmit.disabled = false;
      if (result.error) { message(registerMessage, result.error.message); return; }
      message(registerMessage, 'Check your email to confirm the account.');
      await renderSession();
    });
    signOut?.addEventListener('click', async () => { await supabase?.auth.signOut(); message(loginMessage, 'Signed out.'); await renderSession(); });
    supabase?.auth.onAuthStateChange(() => window.setTimeout(() => void renderSession(), 0));
    void renderSession();
  </script>
</BaseLayout>

<style>
  .account-page {
    max-width: 1060px;
    margin: 0 auto;
    padding: 48px 40px 82px;
  }

  .account-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--border);
  }

  .account-kicker, .account-card-kicker {
    margin: 0;
    color: #7f94ad;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .18em;
  }

  .account-heading h1 {
    margin: 10px 0 0;
    color: var(--text);
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 600;
    letter-spacing: -.04em;
  }

  .account-lead {
    max-width: 520px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .account-heading-link {
    padding: 10px 0;
    color: #a5b8cc;
    font-size: 13px;
    white-space: nowrap;
  }

  .account-heading-link span { margin-left: 7px; color: var(--accent); }
  .account-heading-link:hover { color: var(--text); }

  .account-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 470px);
    gap: clamp(42px, 8vw, 106px);
    padding-top: 54px;
  }

  .account-overview { padding-top: 5px; }

  .account-product {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #cbd8e7;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .account-product img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .account-overview h2 {
    max-width: 440px;
    margin: 34px 0 0;
    color: var(--text);
    font-size: clamp(25px, 3vw, 34px);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: 1.1;
  }

  .account-overview-copy {
    max-width: 450px;
    margin: 17px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .account-points {
    max-width: 470px;
    margin: 40px 0 0;
    border-top: 1px solid var(--border);
  }

  .account-points div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 18px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
  }

  .account-points dt { color: #c8d5e4; font-size: 12px; font-weight: 600; }
  .account-points dd { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

  .account-form-wrap { min-width: 0; }
  .account-auth-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

  .account-card {
    padding: 28px;
    border: 1px solid #2a3a52;
    border-radius: 10px;
    background: #111a28;
  }

  .account-card-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 18px;
  }

  .account-card h2 {
    margin: 9px 0 0;
    color: var(--text);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -.025em;
  }

  .account-card-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid #36526e;
    border-radius: 7px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
  }

  .account-card-description {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .account-fields { display: grid; gap: 18px; margin-top: 26px; }
  .account-field { display: grid; gap: 8px; }
  .account-field label { color: #c1cedd; font-size: 12px; font-weight: 600; }
  .account-field input {
    box-sizing: border-box;
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border: 1px solid #34465e;
    border-radius: 6px;
    outline: none;
    background: #0d1521;
    color: var(--text);
    font: inherit;
    font-size: 13px;
  }

  .account-field input:hover { border-color: #4c6480; }
  .account-field input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(117,224,193,.12); }

  .account-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 25px; }
  .account-submit, .account-toggle {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 6px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .account-submit { border: 1px solid var(--accent); background: var(--accent); color: #0a1717; }
  .account-submit:hover { filter: brightness(1.07); }
  .account-submit:disabled { cursor: wait; opacity: .65; }
  .account-toggle { border: 1px solid #34465e; background: #182438; color: #cdd9e7; }
  .account-toggle:hover { border-color: #58728f; color: var(--text); }
  .account-message { min-height: 20px; margin: 14px 0 0; color: #91a6bc; font-size: 12px; line-height: 1.5; }
  .account-notice { padding: 15px 17px; border: 1px solid #765d31; border-radius: 8px; background: #241e15; color: #d5b77b; font-size: 13px; line-height: 1.5; }
  .signed-in-card h2 { margin-top: 12px; }
  .signed-in-email { margin: 18px 0 0; color: #dce7f3; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
  .signed-in-card .account-toggle { margin-top: 24px; }
  .account-footnote { margin: 15px 2px 0; color: #6f8399; font-size: 11px; line-height: 1.5; }

  @media (max-width: 760px) {
    .account-page { padding: 34px 20px 58px; }
    .account-heading { align-items: start; flex-direction: column; gap: 18px; }
    .account-heading-link { padding: 0; }
    .account-layout { display: block; padding-top: 38px; }
    .account-overview { margin-bottom: 38px; }
    .account-points div { grid-template-columns: 1fr; gap: 5px; }
    .account-auth-grid { grid-template-columns: 1fr; }
    .account-card { padding: 22px; }
  }
</style>
