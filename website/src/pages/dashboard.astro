---
import BaseLayout from '../layouts/BaseLayout.astro';

const providers = [
  { name: 'FileMirage', kind: 'HOT · direct delivery', key: 'filemirage', tone: 'blue' },
  { name: 'Telegram', kind: 'COLD · retained packs', key: 'telegram', tone: 'violet' },
  { name: 'Buzzheavier', kind: 'HOT · capability gated', key: 'buzzheavier', tone: 'amber' },
];

const jobs = [
  { key: 'restore', title: 'Pack restore queue', detail: 'Waiting for telemetry', icon: '↗' },
  { key: 'renewal', title: 'HOT renewal window', detail: '18 day policy', icon: '⟳' },
  { key: 'provisioning', title: 'Capacity provisioning', detail: 'No active jobs', icon: '＋' },
];
---

<BaseLayout title="Operations — Vaultnode" description="Live operator dashboard for the Vaultnode game distribution platform.">
  <main class="ops-shell" data-api-base="https://vaultnode.pp.ua">
    <aside class="ops-sidebar">
      <a href="/" class="ops-brand"><span class="ops-brand-mark">V</span><span><strong>VAULTNODE</strong><small>CONTROL PLANE</small></span></a>
      <div class="ops-cluster"><span class="status-dot status-dot-live"></span><span><small>ACTIVE CLUSTER</small><strong>Mantle / production</strong></span><span class="ops-chevron">⌄</span></div>
      <nav class="ops-nav" aria-label="Operations navigation">
        <a class="ops-nav-link active" href="#overview"><span class="nav-glyph">◌</span> Overview</a>
        <a class="ops-nav-link" href="#activity"><span class="nav-glyph">↯</span> Activity</a>
        <a class="ops-nav-link" href="#storage"><span class="nav-glyph">▣</span> Storage</a>
        <a class="ops-nav-link" href="#providers"><span class="nav-glyph">⌁</span> Providers</a>
      </nav>
      <div class="ops-sidebar-footer"><div class="sidebar-rule"></div><div class="mini-health"><span class="status-dot status-dot-live"></span><span><strong id="sidebar-health">Connected</strong><small id="sidebar-sync">Waiting for first sync</small></span></div><a href="/" class="back-link">← Back to site</a></div>
    </aside>

    <section class="ops-content" id="overview">
      <header class="ops-topbar"><div><span class="eyebrow">SERVER OPERATIONS</span><h1>Good evening, Marko.</h1></div><div class="topbar-actions"><span class="live-pill"><span class="pulse-dot"></span><span id="live-label">Live monitor</span></span><button class="icon-button" id="refresh-button" type="button" aria-label="Refresh telemetry">↻</button><button class="connect-button" id="connect-button" type="button">Connect telemetry <span>→</span></button></div></header>

      <div class="operator-banner" id="operator-banner"><div class="banner-icon">◈</div><div><strong>Operator telemetry is locked</strong><p>Health and readiness are public. Connect an operator token to view storage capacity, provider health, restore queues, and live workload data. The token stays in this tab only.</p></div><button class="banner-action" id="banner-connect" type="button">Connect</button></div>

      <div class="overview-grid">
        <article class="hero-status card-surface"><div class="card-label">SYSTEM STATUS</div><div class="hero-status-row"><div><h2 id="system-status">Checking system</h2><p id="system-detail">Contacting the Mantle control plane…</p></div><div class="system-orb" id="system-orb"><span></span></div></div><div class="hero-meta"><span><i class="status-dot status-dot-live"></i> API <b id="api-state">Checking</b></span><span><i class="status-dot status-dot-muted"></i> Worker <b>Private</b></span><span><i class="status-dot status-dot-muted"></i> Database <b id="database-state">Protected</b></span></div></article>
        <article class="metric-card card-surface"><div class="metric-heading"><span class="card-label">API LATENCY</span><span class="metric-spark spark-blue"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div><div class="metric-value" id="latency-value">—</div><p>Readiness response · last probe</p><div class="metric-foot"><span class="metric-good" id="latency-state">Awaiting probe</span><span id="last-probe">—</span></div></article>
        <article class="metric-card card-surface"><div class="metric-heading"><span class="card-label">ACTIVE WORK</span><span class="metric-icon icon-violet">↯</span></div><div class="metric-value" id="active-work">—</div><p>Restore and provisioning jobs</p><div class="metric-foot"><span class="metric-good" id="work-state">Protected telemetry</span><span>now</span></div></article>
        <article class="metric-card card-surface"><div class="metric-heading"><span class="card-label">STORAGE COVERAGE</span><span class="metric-icon icon-green">✓</span></div><div class="metric-value" id="coverage-value">—</div><p>Verified provider locations</p><div class="metric-foot"><span class="metric-good" id="coverage-state">Protected telemetry</span><span>policy</span></div></article>
      </div>

      <div class="section-heading" id="activity"><div><span class="eyebrow">CURRENTLY RUNNING</span><h2>Activity overview</h2></div><span class="section-note" id="activity-note">Connect telemetry for live jobs</span></div>
      <div class="activity-grid">
        <article class="activity-card card-surface"><div class="activity-card-head"><div><span class="card-label">WORK QUEUE</span><h3>What the platform is doing</h3></div><span class="queue-count" id="queue-count">—</span></div><div class="job-list" id="job-list">{jobs.map((job) => <div class="job-row" data-job={job.key}><span class={`job-icon job-${job.key}`}>{job.icon}</span><span class="job-copy"><strong>{job.title}</strong><small>{job.detail}</small></span><span class="job-state">—</span></div>)}</div></article>
        <article class="activity-card card-surface throughput-card"><div class="activity-card-head"><div><span class="card-label">REQUEST FLOW</span><h3>Control plane traffic</h3></div><span class="time-filter">Last 15 min · live</span></div><div class="chart-wrap"><div class="chart-y"><span>100</span><span>50</span><span>0</span></div><div class="chart"><div class="chart-grid"></div><svg viewBox="0 0 620 190" role="img" aria-label="Request flow chart"><defs><linearGradient id="chart-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#62b9ff" stop-opacity=".24"/><stop offset="1" stop-color="#62b9ff" stop-opacity="0"/></linearGradient></defs><path class="chart-area" d="M0 155 C36 143 48 150 76 132 S122 120 148 132 S182 104 215 118 S258 110 285 92 S325 118 352 105 S394 75 425 84 S463 68 486 86 S518 55 548 70 S585 42 620 48 V190 H0 Z"/><path class="chart-line" d="M0 155 C36 143 48 150 76 132 S122 120 148 132 S182 104 215 118 S258 110 285 92 S325 118 352 105 S394 75 425 84 S463 68 486 86 S518 55 548 70 S585 42 620 48"/></svg><div class="chart-x"><span>−15m</span><span>−10m</span><span>−5m</span><span>now</span></div></div></div><div class="chart-footer"><span><i class="legend-dot blue-dot"></i> Requests / min</span><strong id="request-rate">—</strong></div></article>
      </div>

      <div class="section-heading providers-heading" id="providers"><div><span class="eyebrow">PLACEMENT LAYERS</span><h2>Storage providers</h2></div><a href="#storage" class="section-link">View capacity →</a></div>
      <div class="provider-grid">{providers.map((provider) => <article class={`provider-card card-surface provider-${provider.tone}`} data-provider={provider.key}><div class="provider-top"><span class={`provider-logo logo-${provider.tone}`}>{provider.name.slice(0, 1)}</span><span class="provider-status status-unknown"><i></i> Protected</span></div><h3>{provider.name}</h3><p>{provider.kind}</p><div class="provider-bar"><span></span></div><div class="provider-bottom"><span class="provider-detail">Capacity unavailable</span><strong>—</strong></div></article>)}</div>

      <div class="section-heading storage-heading" id="storage"><div><span class="eyebrow">STORAGE POLICY</span><h2>Tier health at a glance</h2></div><span class="section-note">Pack-first placement · 512 MiB target</span></div>
      <div class="tier-row"><article class="tier-card card-surface"><div class="tier-icon tier-hot">H</div><div><span class="card-label">HOT</span><h3>Fast delivery</h3><p>FileMirage direct pack downloads</p></div><strong id="hot-health">—</strong></article><article class="tier-card card-surface"><div class="tier-icon tier-cold">C</div><div><span class="card-label">COLD</span><h3>Retained archive</h3><p>Telegram physical-pack store</p></div><strong id="cold-health">—</strong></article><article class="tier-card card-surface"><div class="tier-icon tier-archive">R</div><div><span class="card-label">RENEWAL</span><h3>Next window</h3><p>HOT locations renewed after 18 days</p></div><strong id="renewal-health">18d</strong></article></div>

      <footer class="ops-footer"><span>Vaultnode control plane · Mantle / production</span><span id="footer-sync">Telemetry is not connected</span></footer>
    </section>
  </main>

  <dialog class="connect-dialog" id="connect-dialog"><form method="dialog" id="connect-form"><button class="dialog-close" value="cancel" aria-label="Close">×</button><span class="eyebrow">OPERATOR ACCESS</span><h2>Connect live telemetry</h2><p>The API keeps storage and workload data behind operator authentication. Credentials are used for requests from this tab and are never written to local storage.</p><label for="api-base">API endpoint</label><input id="api-base" name="api-base" type="url" value="https://vaultnode.pp.ua" spellcheck="false" required /><label for="operator-token">Operator token</label><input id="operator-token" name="operator-token" type="password" placeholder="Paste token to connect" autocomplete="off" required /><div class="dialog-actions"><button class="dialog-cancel" value="cancel">Cancel</button><button class="dialog-submit" value="default" type="submit">Connect securely →</button></div><small class="dialog-footnote">Use only over HTTPS. The token is cleared when this tab closes.</small></form></dialog>

  <script>
    type ProviderHealth = { provider: string; healthy: boolean; storage_class: string; failure_domain?: string };
    type StorageStatus = { pending_restores: number; storage_health: ProviderHealth[] };
    type Readiness = { status: string; database_ready: boolean };

    const root = document.querySelector<HTMLElement>('.ops-shell');
    const dialog = document.querySelector<HTMLDialogElement>('#connect-dialog');
    const form = document.querySelector<HTMLFormElement>('#connect-form');
    const banner = document.querySelector<HTMLElement>('#operator-banner');
    const apiInput = document.querySelector<HTMLInputElement>('#api-base');
    const tokenInput = document.querySelector<HTMLInputElement>('#operator-token');
    const state: { apiBase: string; token: string; timer: number | null } = { apiBase: root?.dataset.apiBase || 'https://vaultnode.pp.ua', token: '', timer: null };

    const text = (selector: string, value: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
    const parsePrometheus = (body: string): Record<string, number> => Object.fromEntries([...body.matchAll(/^([a-zA-Z_:][a-zA-Z0-9_:]*)(?:\{[^}]*\})?\s+([-+0-9.eE]+)$/gm)].map((match) => [match[1], Number(match[2])]));
    const setBanner = (visible: boolean) => { banner?.classList.toggle('is-hidden', !visible); };
    const setProtected = () => { text('#live-label', 'Health online'); text('#system-status', 'API online'); text('#system-detail', 'Public health is responding. Operator telemetry is locked.'); text('#api-state', 'Online'); text('#database-state', 'Protected'); text('#latency-state', 'Public probe'); text('#work-state', 'Operator access required'); text('#coverage-state', 'Operator access required'); text('#activity-note', 'Operator access required'); text('#footer-sync', 'Health checked · protected metrics unavailable'); document.querySelector('#system-orb')?.classList.add('orb-online'); };

    async function refreshTelemetry() {
      const started = Date.now();
      const headers: HeadersInit = state.token ? { Authorization: `Bearer ${state.token}` } : {};
      try {
        const ready = await fetch(`${state.apiBase.replace(/\/$/, '')}/v1/ready`, { headers, cache: 'no-store' });
        const latency = Date.now() - started;
        text('#latency-value', `${latency}ms`); text('#last-probe', 'just now'); text('#latency-state', ready.ok ? 'Healthy response' : 'Degraded response');
        if (!ready.ok) throw new Error(`Readiness returned ${ready.status}`);
        const readiness = await ready.json() as Readiness;
        text('#system-status', readiness.status === 'ready' ? 'Operational' : 'Degraded'); text('#system-detail', `Mantle control plane · checked ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`); text('#api-state', 'Online'); text('#database-state', readiness.database_ready ? 'Ready' : 'Degraded'); text('#sidebar-health', 'Operational'); text('#sidebar-sync', 'Synced just now'); text('#footer-sync', `Last sync ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`); document.querySelector('#system-orb')?.classList.add('orb-online');
        if (!state.token) { setProtected(); return; }
        const [statusResponse, metricsResponse] = await Promise.all([fetch(`${state.apiBase.replace(/\/$/, '')}/api/v1/storage/status`, { headers, cache: 'no-store' }), fetch(`${state.apiBase.replace(/\/$/, '')}/api/v1/storage/metrics`, { headers, cache: 'no-store' })]);
        if (!statusResponse.ok || !metricsResponse.ok) throw new Error('Operator telemetry request was rejected');
        const status = await statusResponse.json() as StorageStatus; const metrics = parsePrometheus(await metricsResponse.text());
        setBanner(false); text('#live-label', 'Live monitor'); text('#active-work', `${status.pending_restores || 0}`); text('#queue-count', `${status.pending_restores || 0} active`); text('#work-state', status.pending_restores ? 'Restore queue active' : 'Queue clear'); text('#coverage-value', `${status.storage_health.filter((provider) => provider.healthy).length}/${status.storage_health.length || 0}`); text('#coverage-state', 'Healthy locations'); text('#activity-note', `${status.pending_restores || 0} restore jobs pending`); text('#request-rate', metrics.launcher_storage_restore_pending !== undefined ? `${metrics.launcher_storage_restore_pending} pending` : 'No queue');
        const hot = status.storage_health.filter((provider: ProviderHealth) => provider.storage_class === 'HOT' && provider.healthy).length; const cold = status.storage_health.filter((provider: ProviderHealth) => provider.storage_class === 'COLD' && provider.healthy).length; text('#hot-health', hot ? `${hot} healthy` : 'Needs attention'); text('#cold-health', cold ? `${cold} healthy` : 'Needs attention');
        status.storage_health.forEach((provider: ProviderHealth) => { const card = document.querySelector<HTMLElement>(`[data-provider="${provider.provider}"]`); if (!card) return; const badge = card.querySelector<HTMLElement>('.provider-status'); if (badge) { badge.className = `provider-status ${provider.healthy ? 'status-good' : 'status-bad'}`; badge.innerHTML = `<i></i> ${provider.healthy ? 'Healthy' : 'Degraded'}`; } const detail = card.querySelector<HTMLElement>('.provider-detail'); if (detail) detail.textContent = provider.failure_domain || 'Configured provider'; const bar = card.querySelector<HTMLElement>('.provider-bar span'); if (bar) bar.style.width = provider.healthy ? '100%' : '38%'; });
        document.querySelectorAll<HTMLElement>('.job-row').forEach((row) => { const jobState = row.querySelector<HTMLElement>('.job-state'); if (jobState) jobState.textContent = row.dataset.job === 'restore' ? (status.pending_restores ? `${status.pending_restores} queued` : 'Queue clear') : 'Standing by'; });
      } catch (error) {
        if (!state.token) setProtected(); else { text('#live-label', 'Connection error'); text('#system-status', 'Telemetry offline'); text('#system-detail', error instanceof Error ? error.message : 'Could not reach the control plane'); text('#sidebar-health', 'Needs attention'); text('#sidebar-sync', 'Sync failed'); }
      }
    }

    function openDialog() { if (dialog?.showModal) dialog.showModal(); else dialog?.setAttribute('open', ''); tokenInput?.focus(); }
    document.querySelector('#connect-button')?.addEventListener('click', openDialog); document.querySelector('#banner-connect')?.addEventListener('click', openDialog); document.querySelector('#refresh-button')?.addEventListener('click', refreshTelemetry);
    form?.addEventListener('submit', (event) => { event.preventDefault(); if (!apiInput || !tokenInput || !dialog) return; state.apiBase = apiInput.value.trim().replace(/\/$/, ''); state.token = tokenInput.value.trim(); dialog.close(); setBanner(false); refreshTelemetry(); if (state.timer !== null) clearInterval(state.timer); state.timer = window.setInterval(refreshTelemetry, 15000); });
    refreshTelemetry();
  </script>
</BaseLayout>
