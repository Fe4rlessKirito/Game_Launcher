---
import OpsFrame from '../../components/OpsFrame.astro';

const providers = [
  { name: 'FileMirage', tier: 'HOT', kind: 'Direct pack delivery', key: 'filemirage', tone: 'blue', note: 'Primary hot mirror' },
  { name: 'Telegram', tier: 'COLD', kind: 'Retained physical-pack archive', key: 'telegram', tone: 'violet', note: 'Recovery source' },
  { name: 'Buzzheavier', tier: 'HOT', kind: 'Secondary mirror', key: 'buzzheavier', tone: 'amber', note: 'Secondary delivery' },
];
---

<OpsFrame active="providers" title="Providers">
  <div class="page-intro"><div><span class="eyebrow">STORAGE PROVIDERS</span><h2>Provider availability</h2><p>Current availability and stored usage.</p></div><span class="page-chip">Read-only</span></div>

  <div class="provider-detail-grid">{providers.map((provider) => <article class={`provider-detail-card card-surface provider-${provider.tone}`} data-provider={provider.key}><div class="provider-detail-head"><span class={`provider-logo logo-${provider.tone}`}>{provider.name.slice(0, 1)}</span><span class="provider-status status-unknown"><i></i> Checking</span></div><div><span class="card-label">{provider.tier} PROVIDER</span><h2>{provider.name}</h2><p>{provider.kind}</p></div><div class="provider-capability"><span><strong>Status</strong><b class="provider-detail-status">Checking</b></span><span><strong>Role</strong><b>{provider.note}</b></span><span><strong>Stored usage</strong><b class="provider-usage">—</b></span></div></article>)}</div>
</OpsFrame>
