---
import BaseLayout from '../layouts/BaseLayout.astro';

const repositoryUrl = 'https://github.com/Fe4rlessKirito/Game_Launcher';
const installerUrl = `${repositoryUrl}/releases/latest/download/Vaultnode-Setup.exe`;
const releasesUrl = `${repositoryUrl}/releases`;
---

<BaseLayout title="Download — Vaultnode" description="Download the latest Vaultnode Windows installer from GitHub Releases.">
  <section class="mx-auto max-w-4xl px-6 py-24 lg:px-10">
    <p class="text-xs font-semibold tracking-[0.24em] text-accent">WINDOWS INSTALLER</p>
    <h1 class="mt-6 text-5xl font-semibold tracking-[-0.04em] text-copy">Your library, ready when you are.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">Install the latest Vaultnode desktop launcher directly from GitHub Releases. The installer sets up the Windows client and adds a Start Menu shortcut.</p>

    <div class="mt-10 rounded-2xl border border-border bg-surface p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] text-accent">LATEST RELEASE</p>
          <h2 class="mt-3 text-xl font-semibold text-copy">Vaultnode for Windows</h2>
          <p class="mt-1 text-sm text-muted">A single installer for Windows x64</p>
        </div>
        <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">GITHUB RELEASE</span>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a class="inline-flex items-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-background transition hover:brightness-110" href={installerUrl} aria-label="Download the latest Vaultnode Windows installer">
          Download installer <span class="ml-2" aria-hidden="true">↓</span>
        </a>
        <a class="inline-flex items-center rounded-lg border border-border bg-elevated px-5 py-3 text-sm font-semibold text-copy transition hover:border-accent" href={releasesUrl} target="_blank" rel="noreferrer">View release notes <span class="ml-2" aria-hidden="true">↗</span></a>
      </div>
      <p class="mt-4 text-xs text-muted">Downloads as <span class="font-semibold text-copy">Vaultnode-Setup.exe</span>. Windows may ask for confirmation because the installer is not code-signed yet.</p>
    </div>

    <div class="mt-8 grid gap-3 text-sm text-muted sm:grid-cols-3">
      <div class="rounded-lg bg-elevated px-4 py-4"><strong class="block text-copy">Install</strong><span class="mt-1 block">Guided setup with an uninstall entry.</span></div>
      <div class="rounded-lg bg-elevated px-4 py-4"><strong class="block text-copy">Update</strong><span class="mt-1 block">Install a newer release over the existing client.</span></div>
      <div class="rounded-lg bg-elevated px-4 py-4"><strong class="block text-copy">Repair</strong><span class="mt-1 block">Keep the launcher ready for verified installs.</span></div>
    </div>
  </section>
</BaseLayout>
