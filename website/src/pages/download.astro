---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Download — Vaultnode">
  <section class="mx-auto max-w-4xl px-6 py-24 lg:px-10"><p class="text-xs font-semibold tracking-[0.24em] text-accent">COMING SOON</p><h1 class="mt-6 text-5xl font-semibold tracking-[-0.04em] text-copy">Your library, ready when you are.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-muted">The Vaultnode desktop launcher is being prepared for Windows. It will handle installs, updates, repairs, and offline-ready game libraries from one place.</p><div class="mt-10 rounded-2xl border border-border bg-surface p-6"><div class="flex flex-wrap items-center justify-between gap-4"><div><h2 class="text-xl font-semibold text-copy">Windows desktop launcher</h2><p class="mt-1 text-sm text-muted">Release channel coming soon</p></div><span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">IN DEVELOPMENT</span></div><div class="mt-6 grid gap-3 text-sm text-muted sm:grid-cols-3"><span class="rounded-lg bg-elevated px-3 py-3">Install</span><span class="rounded-lg bg-elevated px-3 py-3">Update</span><span class="rounded-lg bg-elevated px-3 py-3">Repair</span></div></div></section>
</BaseLayout>
