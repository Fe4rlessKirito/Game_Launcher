---
import '../styles/global.css';

interface Props { title?: string; description?: string; chrome?: boolean; }
const { title = 'Vaultnode — verified game distribution', description = 'A high-performance launcher foundation for authorized game builds.', chrome = true } = Astro.props;
const productName = 'Vaultnode';
const dashboardHref = '/dashboard/?v=1';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/vaultnode-mark.png" />
    <link rel="apple-touch-icon" href="/assets/vaultnode-mark.png" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'page-no-chrome': !chrome }}>
    {chrome && <header class="site-header mx-auto flex max-w-6xl items-center justify-between px-6 py-7 lg:px-10">
      <a href="/" class="site-brand"><img class="site-brand-mark" src="/assets/vaultnode-mark.png" alt="" /><span><strong>{productName.toUpperCase()}</strong><small>LAUNCHER INFRASTRUCTURE</small></span></a>
      <nav aria-label="Primary navigation" class="site-nav"><a href="/#architecture" class="site-nav-link">Overview</a><a href={dashboardHref} class="site-nav-link">Status</a><a href="/account/" class="site-nav-link">Account</a><a href="/download/" class="site-nav-cta">Download</a></nav>
    </header>}
    <main><slot /></main>
    {chrome && <footer class="site-footer mx-auto flex max-w-6xl flex-col gap-3 border-t border-border px-6 py-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between lg:px-10"><span>{productName} · authorized distribution</span><span>Built for reliable installs.</span></footer>}
  </body>
</html>
