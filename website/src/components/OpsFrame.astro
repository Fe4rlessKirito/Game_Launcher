---
import BaseLayout from '../layouts/BaseLayout.astro';

type PageKey = 'overview' | 'activity' | 'storage' | 'providers';
interface Props {
  active: PageKey;
  title: string;
}

const { active, title } = Astro.props;
const navigation: Array<{ key: PageKey; label: string; glyph: string; href: string }> = [
  { key: 'overview', label: 'Overview', glyph: '◌', href: '/dashboard/' },
  { key: 'activity', label: 'Activity', glyph: '↯', href: '/dashboard/activity/' },
  { key: 'storage', label: 'Storage', glyph: '▣', href: '/dashboard/storage/' },
  { key: 'providers', label: 'Providers', glyph: '⌁', href: '/dashboard/providers/' },
];
---

<BaseLayout title={`${title} — Vaultnode`} description="Public operations dashboard for the Vaultnode game distribution platform." chrome={false}>
  <main class="ops-shell" data-api-base="https://vaultnode.pp.ua" data-ops-page={active}>
    <aside class="ops-sidebar">
      <a href="/" class="ops-brand"><img class="ops-brand-image" src="/assets/vaultnode-mark.png" alt="Vaultnode" /><span><strong>VAULTNODE</strong><small>PUBLIC STATUS</small></span></a>
      <div class="ops-cluster" aria-label="System status"><span class="status-dot status-dot-live"></span><span><small>STATUS</small><strong id="cluster-status">Operational</strong></span><span class="ops-chevron">⌄</span></div>
      <nav class="ops-nav" aria-label="Operations navigation">
        {navigation.map((item) => <a class:list={['ops-nav-link', active === item.key && 'active']} href={item.href} aria-current={active === item.key ? 'page' : undefined}><span class="nav-glyph">{item.glyph}</span> {item.label}</a>)}
      </nav>
      <div class="ops-sidebar-footer"><div class="sidebar-rule"></div><div class="mini-health"><span class="status-dot status-dot-live"></span><span><strong id="sidebar-health">Connected</strong><small id="sidebar-sync">Waiting for first sync</small></span></div><a href="/" class="back-link">← Back to site</a></div>
    </aside>

    <section class="ops-content">
      <header class="ops-topbar"><div><span class="eyebrow">SYSTEM STATUS</span></div><div class="topbar-actions"><span class="live-pill"><span class="pulse-dot"></span><span id="live-label" aria-live="polite">Checking</span></span><button class="icon-button" id="refresh-button" type="button" aria-label="Refresh status">↻</button></div></header>
      <div class="operator-banner public-banner" role="status"><div class="banner-icon">●</div><div><strong>Live system status</strong><p>Health, storage, and workload metrics update automatically.</p></div><span class="public-banner-note">Auto-refresh</span></div>
      <slot />
      <footer class="ops-footer"><span>Vaultnode · public status</span><span id="footer-sync">Waiting for update</span></footer>
    </section>
  </main>

  <script>
    type ProviderHealth = { provider: string; healthy: boolean; tier: string };
    type ProviderUsage = { provider: string; tier: string; used_bytes: number; last_capacity_check?: string };
    type SystemMetrics = { cpu_usage_percent?: number; memory_used_bytes?: number; memory_total_bytes?: number; disk_used_bytes?: number; disk_total_bytes?: number; measured_at?: string };
    type PublicWorkStatus = { id: string; kind: string; state: string; game?: string | null; version?: string | null; provider?: string | null; detail?: string; progress_percent?: number | null; updated_at?: string };
    type PublicStatus = { status: string; database_ready: boolean; storage_configured: boolean; providers: ProviderHealth[]; usage: ProviderUsage[]; total_used_bytes: number; pending_restores: number; active_work?: PublicWorkStatus[]; system?: SystemMetrics; last_probe_at?: string; last_successful_probe_at?: string; probe_duration_ms?: number; probe_interval_seconds: number; stale: boolean };

    const root = document.querySelector<HTMLElement>('.ops-shell');
    const apiBase = root?.dataset.apiBase || 'https://vaultnode.pp.ua';
    const text = (selector: string, value: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
    const workKind = (kind: string) => ({ SCRAPER: 'Release ingestion', REUPLOAD: 'HOT reupload', RESTORE: 'Storage restore' } as Record<string, string>)[kind] || 'Active operation';
    const workState = (state: string) => ({ QUEUED: 'Queued', DISCOVERING: 'Checking source', DOWNLOADING: 'Downloading', VALIDATING: 'Validating', RESTORING: 'Restoring', REUPLOADING: 'Reuploading' } as Record<string, string>)[state] || state;
    const renderActiveWork = (items: PublicWorkStatus[]) => {
      const current = items[0];
      if (!current) {
        text('#live-work-kind', 'Standing by'); text('#live-work-game', 'Queue clear'); text('#live-work-version', ''); text('#live-work-state', 'No active scraper or reupload'); text('#live-work-detail', 'Waiting for the next authorized operation.'); text('#live-work-provider', ''); text('#live-work-count', 'clear'); text('#public-work-signal', 'Clear');
        const icon = document.querySelector<HTMLElement>('#live-work-icon'); if (icon) { icon.className = 'job-icon job-scraper'; icon.textContent = '↓'; }
        const progress = document.querySelector<HTMLElement>('#live-work-progress-wrap'); if (progress) progress.hidden = true;
        return;
      }
      const game = current.game || (current.kind === 'REUPLOAD' ? 'HOT pack renewal' : 'Active operation');
      const version = current.version ? 'Version ' + current.version : '';
      const count = items.length > 1 ? String(items.length) + ' active' : '1 active';
      text('#live-work-kind', workKind(current.kind)); text('#live-work-game', game); text('#live-work-version', version); text('#live-work-state', workState(current.state)); text('#live-work-detail', current.detail || 'Working'); text('#live-work-provider', current.provider || ''); text('#live-work-count', count); text('#public-work-signal', count);
      const icon = document.querySelector<HTMLElement>('#live-work-icon'); if (icon) { icon.className = 'job-icon job-' + current.kind.toLowerCase(); icon.textContent = current.kind === 'REUPLOAD' ? '⟳' : current.kind === 'RESTORE' ? '↗' : '↓'; }
      const progressWrap = document.querySelector<HTMLElement>('#live-work-progress-wrap'); const progressBar = document.querySelector<HTMLElement>('#live-work-progress'); const progressLabel = document.querySelector<HTMLElement>('#live-work-progress-label');
      if (progressWrap && progressBar && progressLabel && current.progress_percent != null) { progressWrap.hidden = false; progressBar.style.width = String(Math.max(0, Math.min(100, current.progress_percent))) + '%'; progressLabel.textContent = current.progress_percent.toFixed(0) + '%'; } else if (progressWrap) progressWrap.hidden = true;
    };
    const formatBytes = (value: number) => { if (!Number.isFinite(value) || value <= 0) return '0 B'; if (value < 1024 ** 2) return `${(value / 1024).toFixed(1)} KB`; if (value < 1024 ** 3) return `${(value / 1024 ** 2).toFixed(1)} MB`; if (value < 1024 ** 4) return `${(value / 1024 ** 3).toFixed(2)} GB`; return `${(value / 1024 ** 4).toFixed(2)} TB`; };

    async function refreshTelemetry() {
      try {
        const publicResponse = await fetch(`${apiBase.replace(/\/$/, '')}/api/v1/public/status`, { cache: 'no-store' });
        if (!publicResponse.ok) throw new Error(`Public status returned ${publicResponse.status}`);
        const publicStatus = await publicResponse.json() as PublicStatus;
        const observed = publicStatus.last_probe_at ? new Date(publicStatus.last_probe_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'starting';
        text('#latency-value', publicStatus.probe_duration_ms == null ? '—' : `${publicStatus.probe_duration_ms}ms`); text('#last-probe', observed); text('#latency-state', publicStatus.stale ? 'Stale snapshot' : 'Server probe');
        const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const healthyProviders = publicStatus.providers.filter((provider) => provider.healthy).length;
        const pending = publicStatus.pending_restores || 0;
        const activeWork = publicStatus.active_work || [];
        renderActiveWork(activeWork);
        const operational = publicStatus.status === 'operational'; const healthLabel = operational ? 'Operational' : 'Degraded'; text('#live-label', healthLabel); text('#system-status', healthLabel); text('#system-detail', `Updated ${now}`); text('#api-state', 'Online'); text('#database-state', publicStatus.database_ready ? 'Ready' : 'Degraded'); text('#cluster-status', healthLabel); text('#sidebar-health', healthLabel); text('#sidebar-sync', `Updated ${now}`); text('#footer-sync', `Updated ${now}`); text('#latency-state', 'Healthy response'); text('#active-work', `${pending}`); text('#queue-count', pending ? `${pending} active` : 'clear'); text('#work-state', pending ? 'Restore queue active' : 'No restore jobs'); text('#coverage-value', `${healthyProviders}/${publicStatus.providers.length || 0}`); text('#coverage-state', 'Provider health'); text('#activity-note', `Updated ${now}`); text('#public-api-signal', publicStatus.database_ready ? 'Ready' : 'Degraded'); text('#public-provider-signal', `${healthyProviders}/${publicStatus.providers.length || 0} healthy`); text('#public-restore-signal', pending ? `${pending} queued` : 'Clear'); text('#public-snapshot', now); text('#snapshot-age', 'Updated just now');
        document.querySelector('#system-orb')?.classList.add('orb-online');

        const usageByProvider = new Map<string, number>();
        publicStatus.usage.forEach((account) => { const normalized = account.provider.toLowerCase(); const key = ['filemirage', 'telegram', 'buzzheavier'].find((candidate) => normalized.includes(candidate)); if (key) usageByProvider.set(key, (usageByProvider.get(key) || 0) + (account.used_bytes || 0)); });
        const totalUsed = publicStatus.total_used_bytes || [...usageByProvider.values()].reduce((sum, value) => sum + value, 0);
        text('#total-used', formatBytes(totalUsed)); text('#storage-updated', 'just now'); text('#activity-updated', `Updated ${now}`);
        const setBar = (selector: string, percent: number | undefined) => { const bar = document.querySelector<HTMLElement>(selector); if (bar) bar.style.width = percent == null ? '0%' : `${Math.max(0, Math.min(100, percent))}%`; };
        const system = publicStatus.system;
        const cpu = system?.cpu_usage_percent;
        text('#system-cpu-value', cpu == null ? '—' : `${cpu.toFixed(1)}%`); text('#system-cpu-detail', cpu == null ? 'Waiting for second sample' : 'Server CPU usage'); setBar('#system-cpu-bar', cpu);
        const memoryPercent = system?.memory_used_bytes != null && system.memory_total_bytes ? (system.memory_used_bytes / system.memory_total_bytes) * 100 : undefined;
        text('#system-memory-value', system?.memory_used_bytes == null ? '—' : formatBytes(system.memory_used_bytes)); text('#system-memory-detail', system?.memory_total_bytes == null ? 'Unavailable' : `${formatBytes(system.memory_total_bytes)} total`); setBar('#system-memory-bar', memoryPercent);
        const diskPercent = system?.disk_used_bytes != null && system.disk_total_bytes ? (system.disk_used_bytes / system.disk_total_bytes) * 100 : undefined;
        text('#system-disk-value', system?.disk_used_bytes == null ? '—' : formatBytes(system.disk_used_bytes)); text('#system-disk-detail', system?.disk_total_bytes == null ? 'Unavailable' : `${formatBytes(system.disk_total_bytes)} total`); setBar('#system-disk-bar', diskPercent);
        ['filemirage', 'telegram', 'buzzheavier'].forEach((key) => { const card = document.querySelector<HTMLElement>(`[data-provider="${key}"]`); if (!card) return; const used = usageByProvider.get(key) || 0; const usage = card.querySelector<HTMLElement>('.provider-usage'); if (usage) usage.textContent = formatBytes(used); const detail = card.querySelector<HTMLElement>('.provider-detail'); if (detail) detail.textContent = totalUsed ? `${((used / totalUsed) * 100).toFixed(0)}% of stored data` : 'No packs stored'; const bar = card.querySelector<HTMLElement>('.provider-bar span'); if (bar) bar.style.width = totalUsed ? `${Math.max(used ? 4 : 0, (used / totalUsed) * 100)}%` : '0%'; });
        const hot = publicStatus.providers.filter((provider) => provider.tier === 'HOT' && provider.healthy).length; const cold = publicStatus.providers.filter((provider) => provider.tier === 'COLD' && provider.healthy).length; text('#hot-health', hot ? `${hot} healthy` : 'Needs attention'); text('#cold-health', cold ? `${cold} healthy` : 'Needs attention');
        publicStatus.providers.forEach((provider) => { const key = ['filemirage', 'telegram', 'buzzheavier'].find((candidate) => provider.provider.toLowerCase().includes(candidate)); if (!key) return; const card = document.querySelector<HTMLElement>(`[data-provider="${key}"]`); if (!card) return; const badge = card.querySelector<HTMLElement>('.provider-status'); if (badge) { badge.className = `provider-status ${provider.healthy ? 'status-good' : 'status-bad'}`; badge.innerHTML = `<i></i> ${provider.healthy ? 'Healthy' : 'Degraded'}`; } const detailStatus = card.querySelector<HTMLElement>('.provider-detail-status'); if (detailStatus) detailStatus.textContent = provider.healthy ? 'Healthy and reachable' : 'Degraded'; });
        document.querySelectorAll<HTMLElement>('.job-row').forEach((row) => { const jobState = row.querySelector<HTMLElement>('.job-state'); if (jobState) jobState.textContent = row.dataset.job === 'restore' ? (pending ? `${pending} queued` : 'Queue clear') : 'Standing by'; });
      } catch (error) {
        text('#live-label', 'Unavailable'); text('#system-status', 'Unavailable'); text('#system-detail', 'Could not load the latest status'); text('#cluster-status', 'Unavailable'); text('#sidebar-health', 'Unavailable'); text('#sidebar-sync', 'Update failed'); text('#footer-sync', 'Update failed'); text('#activity-note', 'Update failed');
      }
    }

    document.querySelector('#refresh-button')?.addEventListener('click', refreshTelemetry);
    window.setInterval(refreshTelemetry, 15000);
    refreshTelemetry();
  </script>
</BaseLayout>
