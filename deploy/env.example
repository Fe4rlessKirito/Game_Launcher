POSTGRES_DB=launcher
POSTGRES_USER=launcher
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://launcher:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/launcher
LAUNCHER_BIND=0.0.0.0:8080
LAUNCHER_PUBLIC_BASE_URL=http://localhost
LAUNCHER_OPERATOR_TOKEN=REPLACE_WITH_A_LONG_RANDOM_OPERATOR_TOKEN
LAUNCHER_OPERATOR_AUTH_REQUIRED=true
LAUNCHER_ALLOW_INSECURE_OPERATOR_ENDPOINTS=false
LAUNCHER_ALLOW_DEVELOPMENT_CATALOG=false
# Optional Steam account linking key. Keep it server-side; never ship it in
# the desktop launcher. Steam OpenID still requires the user's own sign-in.
LAUNCHER_STEAM_WEB_API_KEY=
# Set true in production-shaped signing environments so missing key custody
# fails closed instead of generating an untrusted local fixture key.
LAUNCHER_SIGNING_REQUIRE_EXTERNAL_KEY=true
LAUNCHER_CORS_ALLOW_ORIGIN=
# Required by the private API -> restore-worker cold-pack relay when it is
# enabled. Use a separate random secret from the operator token.
LAUNCHER_COLD_STREAM_TOKEN=REPLACE_WITH_A_LONG_RANDOM_INTERNAL_TOKEN
LAUNCHER_COLD_STREAM_WORKER_URL=
LAUNCHER_COLD_STREAM_BIND=0.0.0.0:8081
LAUNCHER_MAX_REQUEST_BYTES=52428800
LAUNCHER_MAX_CONCURRENT_REQUESTS=256
# Per-client API request budget. Exceeded requests receive 429 with Retry-After.
LAUNCHER_RATE_LIMIT_REQUESTS=600
LAUNCHER_RATE_LIMIT_WINDOW_SECONDS=60
LAUNCHER_RESTORE_RATE_LIMIT_REQUESTS=30
LAUNCHER_RESTORE_RATE_LIMIT_WINDOW_SECONDS=60
LAUNCHER_MAX_RESTORE_JOBS_PER_REQUEST=16
LAUNCHER_MAX_PENDING_RESTORE_JOBS=1000
# Only enable when the API is reachable exclusively through a trusted reverse
# proxy that overwrites X-Forwarded-For/X-Real-IP (the Mantle Caddy setup does).
LAUNCHER_TRUST_PROXY_HEADERS=false
# Bounds provider health probes used by readiness/metrics/status endpoints.
LAUNCHER_STORAGE_HEALTH_TIMEOUT_SECONDS=15
LAUNCHER_STORAGE_ROOT=/var/lib/launcher/storage
LAUNCHER_STORAGE_PROVIDERS=local
LAUNCHER_LOCAL_TIER=HOT
LAUNCHER_MIRROR_BASE_URLS=
# With physical packs enabled, relay a sparse missing subset below this
# fraction of the pack instead of downloading the full HOT pack.
LAUNCHER_PACK_SPARSE_RELAY_THRESHOLD=0.5
# Storage policy. Staging should set cold minimum/required to 1.
LAUNCHER_STORAGE_MIN_HOT_REPLICAS=1
LAUNCHER_STORAGE_MIN_COLD_REPLICAS=0
LAUNCHER_STORAGE_MIN_ARCHIVE_REPLICAS=0
LAUNCHER_STORAGE_MIN_HOT_FAILURE_DOMAINS=1
LAUNCHER_STORAGE_MIN_COLD_FAILURE_DOMAINS=0
LAUNCHER_STORAGE_MIN_ARCHIVE_FAILURE_DOMAINS=0
LAUNCHER_STORAGE_PREFERRED_HOT_REPLICAS=1
LAUNCHER_STORAGE_PREFERRED_COLD_REPLICAS=0
LAUNCHER_STORAGE_PREFERRED_ARCHIVE_REPLICAS=0
LAUNCHER_STORAGE_COLD_BACKUP_REQUIRED=false
LAUNCHER_STORAGE_RESTORE_MODE=ON_DEMAND
# Required only when LAUNCHER_STORAGE_PROVIDERS contains s3.
LAUNCHER_S3_PROVIDER_ID=s3-hot
LAUNCHER_S3_TIER=HOT
LAUNCHER_S3_ENDPOINT=
LAUNCHER_S3_REGION=us-east-1
LAUNCHER_S3_BUCKET=
LAUNCHER_S3_ACCESS_KEY=
LAUNCHER_S3_SECRET_KEY=
LAUNCHER_S3_SESSION_TOKEN=
# Set this for a stable public/CDN object URL. Leave empty to use presigned URLs.
LAUNCHER_S3_PUBLIC_BASE_URL=
LAUNCHER_S3_PRESIGN_TTL_SECONDS=900
LAUNCHER_S3_MULTIPART_THRESHOLD_BYTES=8388608
LAUNCHER_S3_MULTIPART_PART_BYTES=8388608
LAUNCHER_S3_ORPHAN_MAX_AGE_SECONDS=86400
LAUNCHER_S3_MAX_ATTEMPTS=4
LAUNCHER_S3_MAX_CONCURRENT_REQUESTS=4
LAUNCHER_S3_FORCE_PATH_STYLE=true
# Optional MEGA configuration is intentionally omitted from the default
# deployment. Staging uses Telegram as its required COLD pack provider.
LAUNCHER_RESTORE_TARGET_PROVIDER=local
LAUNCHER_AUTO_MIGRATE=0
# Generic account/capacity provisioning. Keep the HMAC secret in the
# deployment environment/Cloudflare Worker secret; never commit a resolved value.
PROVISIONING_ENABLED=false
PROVISIONING_EMAIL_DOMAIN=vaultnode.pp.ua
PROVISIONING_EMAIL_INGEST_HMAC_SECRET=
PROVISIONING_EMAIL_MAX_BYTES=5242880
PROVISIONING_EMAIL_ALLOWED_CLOCK_SKEW_SECONDS=300
PROVISIONING_MAIL_ALIAS_TTL_SECONDS=3600
PROVISIONING_DEFAULT_MODE=MANUAL
PROVISIONING_CAPACITY_HEADROOM_BYTES=0
PROVISIONING_ENABLE_FAKE=false
PROVISIONING_SECRET_STORE_DIR=/var/lib/launcher/provisioning-secrets
PROVISIONING_TEMP_DIR=/tmp/launcher-cold
# Public operations status reads advisory active-work records from this shared
# directory. The API and worker must use the same mounted path.
LAUNCHER_WORK_STATUS_DIR=/var/lib/launcher/storage/work-status
LAUNCHER_WORK_STATUS_STALE_SECONDS=900
# Mantle's Compose override applies container ceilings by default. Override
# these only when the VPS capacity and the corresponding staging volume have
# been measured together.
LAUNCHER_POSTGRES_MEMORY_LIMIT=1g
LAUNCHER_POSTGRES_CPUS=2.0
LAUNCHER_POSTGRES_PIDS_LIMIT=256
LAUNCHER_API_MEMORY_LIMIT=768m
LAUNCHER_API_CPUS=2.0
LAUNCHER_API_PIDS_LIMIT=256
LAUNCHER_WORKER_MEMORY_LIMIT=2g
LAUNCHER_WORKER_CPUS=4.0
LAUNCHER_WORKER_PIDS_LIMIT=512
LAUNCHER_SCRAPER_MEMORY_LIMIT=1g
LAUNCHER_SCRAPER_CPUS=2.0
LAUNCHER_SCRAPER_PIDS_LIMIT=256
LAUNCHER_TELEGRAM_API_MEMORY_LIMIT=1g
LAUNCHER_TELEGRAM_API_CPUS=2.0
LAUNCHER_TELEGRAM_API_PIDS_LIMIT=256
LAUNCHER_TELEGRAM_PROXY_MEMORY_LIMIT=256m
LAUNCHER_TELEGRAM_PROXY_CPUS=1.0
LAUNCHER_TELEGRAM_PROXY_PIDS_LIMIT=128
LAUNCHER_CADDY_MEMORY_LIMIT=256m
LAUNCHER_CADDY_CPUS=1.0
LAUNCHER_CADDY_PIDS_LIMIT=128
# Optional isolated server-side release scraper. Keep disabled until each
# source is explicitly authorized; the scraper never publishes automatically.
SCRAPER_ENABLED=false
SCRAPER_STATE_DB=/var/lib/launcher/scraper/scraper-state.db
SCRAPER_OUTPUT_DIR=/var/lib/launcher/scraper/artifacts
SCRAPER_BROWSER=http
SCRAPER_MAX_PAGES=20
SCRAPER_MAX_ACTIONS=40
SCRAPER_MAX_GEMINI_CALLS=6
SCRAPER_JOB_TIMEOUT_SECONDS=180
SCRAPER_MAX_ARTIFACT_BYTES=549755813888
SCRAPER_MAX_ARCHIVE_ENTRIES=2000000
SCRAPER_MAX_ARCHIVE_BYTES=4398046511104
SCRAPER_MAX_ARCHIVE_FILE_BYTES=549755813888
SCRAPER_TEMP_MAX_BYTES=1099511627776
SCRAPER_DIAGNOSTICS_ENABLED=false
SCRAPER_DIAGNOSTICS_DIR=/var/lib/launcher/scraper/diagnostics
SCRAPER_DIAGNOSTICS_MAX_BYTES=524288
SCRAPER_STATUS_DIR=/var/lib/launcher/storage/work-status
# Optional structured fallback; never commit a key or enable localhost access
# in deployment. Leave the model empty for runtime generateContent discovery.
GEMINI_API_KEY=
SCRAPER_GEMINI_MODEL=
SCRAPER_ALLOW_LOCALHOST=false
# Optional off-host PostgreSQL backup replication. Enable the required flag
# only after the destination host key and SSH identity are configured.
BACKUP_DIR=/var/backups/vaultnode
BACKUP_RETENTION_DAYS=14
BACKUP_REPLICATION_REQUIRED=false
BACKUP_REPLICATION_HOST=
BACKUP_REPLICATION_USER=backup
BACKUP_REPLICATION_DIR=
BACKUP_REPLICATION_IDENTITY_FILE=
